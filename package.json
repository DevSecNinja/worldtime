{
  "name": "worldtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-first PWA for sharing an event across time zones.",
  "scripts": {
    "predata:generate": "node scripts/bootstrap-source-data.mjs",
    "data:generate": "node scripts/generate-reference-data.mjs",
    "data:update:cities": "node scripts/update-city-data.mjs",
    "data:package": "node scripts/package-reference-data.mjs",
    "data:bootstrap": "node scripts/bootstrap-reference-data.mjs",
    "predev": "npm run data:bootstrap",
    "dev": "vite",
    "prebuild": "npm run data:bootstrap",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "precheck": "npm run data:bootstrap",
    "check": "tsc -b --pretty false",
    "pretest": "npm run data:bootstrap",
    "test": "npm run test:run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "11.6.1",
    "fuse.js": "7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vvo/tzdb": "6.198.0",
    "cldr-localenames-full": "48.2.0",
    "fast-check": "4.9.0",
    "fflate": "0.8.3",
    "i18n-iso-countries": "7.14.0",
    "jsdom": "30.0.1",
    "moment-timezone": "0.6.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "v26.8.2",
    "npm": "12.0.2"
  }
}
