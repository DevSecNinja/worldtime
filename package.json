{
  "name": "worldtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-first PWA for sharing an event across time zones.",
  "scripts": {
    "data:generate": "node scripts/generate-reference-data.mjs",
    "predev": "npm run data:generate",
    "dev": "vite",
    "prebuild": "npm run data:generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "pretest": "npm run data:generate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "11.6.1",
    "fuse.js": "7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-globe.gl": "2.38.0",
    "temporal-polyfill": "1.0.4",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.10.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vvo/tzdb": "6.198.0",
    "cldr-localenames-full": "48.2.0",
    "fast-check": "4.9.0",
    "fflate": "0.8.3",
    "i18n-iso-countries": "7.14.0",
    "jsdom": "30.0.1",
    "moment-timezone": "0.6.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "world-atlas": "2.0.2"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
